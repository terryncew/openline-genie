+        {
+            "option_id": "OPT-1-SOLAR-EFFICIENCY-SHIFT",
+            "label": "12 kW Shared Solar PV + Heat-Pump Water Heater Daytime Shift + Weatherization",
+            "pv_kw": pv_kw,
+            "hpwh_cop": 3.2,
+            "efficiency_reduction_frac": 0.08,
+            "self_use_fraction": 0.78,
+            "gross_capex_usd": 24800.0,
+            "annual_om_usd": 260.0,
+            "year8_replacement_usd": 1800.0,  # Inverter/controller reserve at Year 8
+            "battery_kwh": 0.0,
