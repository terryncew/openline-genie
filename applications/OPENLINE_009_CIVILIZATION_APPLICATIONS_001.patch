+def evaluate_community_energy_cooperative(custom_inputs: dict[str, Any] | None = None) -> dict[str, Any]:
+    """Evaluates the baseline grid project and 3 credible cooperative alternatives, verifies
+    exact numerical agreement against `conventional_energy_coop_calculator`, runs sensitivity
+    analysis across 6 parameter perturbations, and tests failure-condition traps."""
+    inputs = copy.deepcopy(DEFAULT_ENERGY_COOP_INPUTS)
+    if custom_inputs:
+        inputs.update(custom_inputs)
+    EvidenceTriagedCounterfactualAuditor.verify_no_oracle_leakage(inputs)
+
+    pv_kw = float(inputs.get("solar_array_kw_ac", 12.0))
