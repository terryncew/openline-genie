+        {
+            "option_id": "OPT-3-SOLAR-THERMAL-PCM-WATER",
+            "label": "12 kW Shared Solar PV + Phase-Change Thermal Bank + Gravity Water Header (Priority Router)",
+            "pv_kw": pv_kw,
+            "hpwh_cop": 3.5,
+            "efficiency_reduction_frac": 0.10,
+            "self_use_fraction": 0.91,
+            "gross_capex_usd": 28400.0,
