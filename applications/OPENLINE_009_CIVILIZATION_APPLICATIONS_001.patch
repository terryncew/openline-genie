+        "Defect_10_D3_CA_010": res_c["defect_10_repair_verified"],
+        "applications": {
+            "application_a_franklin": res_a,
+            "application_b_baldwin": res_b,
+            "application_c_morrison": res_c,
+            "application_d_einstein": res_d,
